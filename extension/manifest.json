{
  "manifest_version": 3,
  "name": "Traction \u2014 founder milestones on every new tab",
  "version": "0.2.1",
  "description": "A board of what other founders shipped, sold and raised, on every new tab. Post your own milestone in ten seconds.",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://cdn.jsdelivr.net/*"
    "https://raw.githubusercontent.com/*",
    "https://*.supabase.co/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
